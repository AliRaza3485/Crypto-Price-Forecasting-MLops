# ============================================================
# Template for .env  —  copy this file to .env and fill in your token.
#     cp .env.example .env
# ------------------------------------------------------------
# .env is git-ignored; this .example IS committed so the required shape is
# documented for anyone (or future-you) setting the project up.
#
# Get a token:  DagsHub -> your avatar -> Settings -> Tokens -> create token
# ============================================================

MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<your_dagshub_username>
MLFLOW_TRACKING_PASSWORD=<your_dagshub_token>
